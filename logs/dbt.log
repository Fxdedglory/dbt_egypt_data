    create  table
      "egypt_demo"."main_mart"."fct_artifact_flows__dbt_tmp"
  
    as (
      with f as (
  select * from "egypt_demo"."main_stg"."stg_flows"
),
n as (
  select node_id, name as node_name, country as country
  from "egypt_demo"."main_mart"."dim_nodes"
)
select
  f.flow_id,
  f.artifact_id,
  f.from_node_id,
  fn.node_name as from_name,
  f.to_node_id,
  tn.node_name as to_name,
  f.flow_type,
  f.era,
  f.year_start,
  f.year_end,
  f.duration_years,
  f.route_key,
  -- extra transform to ensure cross-model lineage
  (fn.country || '→' || tn.country) as route_countries
from f
left join n fn on fn.node_id = f.from_node_id
left join n tn on tn.node_id = f.to_node_id
    );
  
  
