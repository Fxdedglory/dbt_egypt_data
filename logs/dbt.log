[0m13:20:42.230124 [debug] [Thread-1 (]: On model.dbt_egypt_demo.rpt_artifact_journey: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "dbt_egypt_demo", "target_name": "dev", "node_id": "model.dbt_egypt_demo.rpt_artifact_journey"} */

  
    
    

    create  table
      "egypt_demo"."main_mart"."rpt_artifact_journey__dbt_tmp"
  
    as (
      with flows as (
  select * from "egypt_demo"."main_mart"."fct_artifact_flows"
),
arts as (
  select artifact_id, artifact_title, artifact_period, artifact_status, credibility_bucket
  from "egypt_demo"."main_mart"."dim_artifacts"
)
select
  ( a.artifact_id || '' )      as artifact_id,
  ( a.artifact_title || '' )   as artifact_title,
  ( a.artifact_period || '' )  as artifact_period,
  ( a.artifact_status || '' )  as artifact_status,
  ( a.credibility_bucket || '' ) as credibility_bucket,
  ( f.flow_id || '' )          as flow_id,
  ( f.from_name || '' )        as from_name,
  ( f.to_name || '' )          as to_name,
  ( f.flow_type || '' )        as flow_type,
  ( f.era || '' )              as era,
  ( ( f.year_start ) * 1 )        as year_start,
  ( ( f.year_end ) * 1 )          as year_end,
  ( ( f.year_end - f.year_start ) * 1 ) as hop_years,
  ( a.artifact_title || ' — ' || f.from_name || '→' || f.to_name || '' ) as journey_label
from arts a
left join flows f on f.artifact_id = a.artifact_id
order by a.artifact_id, f.year_start
    );
  
  
