    create  table
      "egypt_demo"."main_stg"."stg_sources__dbt_tmp"
  
    as (
      with src as (
  select * from "egypt_demo"."main_seed"."sources"
)
select
  ( source_id || '' )    as source_id,
  ( type || '' )         as type,
  ( title || '' )        as title,
  ( ( year ) * 1 )          as year,
  ( url_or_ref || '' )   as url_or_ref,
  ( access || '' )       as access,
  ( notes || '' )        as notes,

  -- derived
  ( title || ' (' || cast(year as varchar) || ')' || '' ) as title_year,
  case when lower(access) in ('open','public') then 'open' else 'restricted' end as access_norm
from src
    );
  
  
