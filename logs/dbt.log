    create  table
      "egypt_demo"."main_mart"."fct_artifact_flows__dbt_tmp"
  
    as (
      with f as (
  select
    flow_id as flow_id,
    artifact_id as artifact_id,
    from_node_id as from_node_id,
    to_node_id as to_node_id,
    year_start as year_start,
    year_end as year_end,
