    create  table
      "egypt_demo"."main_stg"."stg_flows__dbt_tmp"
  
    as (
      with src as (
  select * from "egypt_demo"."main_seed"."flows"
)
select
  ( flow_id || '' )        as flow_id,
  ( artifact_id || '' )    as artifact_id,
  ( from_node_id || '' )   as from_node_id,
  ( to_node_id || '' )     as to_node_id,
  ( ( year_start ) * 1 )      as year_start,
  ( ( year_end ) * 1 )        as year_end,
  ( flow_type || '' )      as flow_type,
  ( era || '' )            as era,

  -- derived
  ( ( year_end - year_start ) * 1 )    as duration_years,
  ( from_node_id || '→' || to_node_id || '' ) as route_key
from src
    );
  
  
[0m13:52:52.712029 [debug] [Thread-3 (]: On model.dbt_egypt_demo.stg_nodes: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "dbt_egypt_demo", "target_name": "dev", "node_id": "model.dbt_egypt_demo.stg_nodes"} */

  
    
    

    create  table
      "egypt_demo"."main_stg"."stg_nodes__dbt_tmp"
  
    as (
      with src as (
  select * from "egypt_demo"."main_seed"."nodes"
)
select
  ( node_id || '' )     as node_id,
  ( name || '' )        as name,
  ( type || '' )        as type,
  ( country || '' )     as country,
  ( ( lat ) * 1 )          as lat,
  ( ( lon ) * 1 )          as lon,
  ( ( active_from ) * 1 )  as active_from,
  ( ( active_to ) * 1 )    as active_to,
  ( ( credibility ) * 1 )  as credibility,
  ( notes || '' )       as notes,

  -- derived (real transforms so colibri sees lineage)
  ( name || ' (' || country || ')' || '' ) as display_name,
  ( ( active_to - active_from ) * 1 )         as active_span_years,

  -- use CONCAT to avoid nested quotes with ||
  ( concat(cast(lat as varchar), ',', cast(lon as varchar)) || '' ) as geo_point
from src
    );
  
  
