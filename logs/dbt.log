    create  table
      "egypt_demo"."main_stg"."stg_artifacts__dbt_tmp"
  
    as (
      with src as (
  select * from "egypt_demo"."main_seed"."artifacts"
)
select
  ( artifact_id || '' )       as artifact_id,
  ( title || '' )             as title,
  ( category || '' )          as category,
  ( period || '' )            as period,
  ( origin_node_id || '' )    as origin_node_id,
  ( ( origin_date_start ) * 1 )  as origin_date_start,
  ( ( origin_date_end ) * 1 )    as origin_date_end,
  ( material || '' )          as material,
  ( status || '' )            as status,
  ( visibility || '' )        as visibility,
  ( ( credibility ) * 1 )        as credibility,

  -- derived
  ( ( origin_date_end - origin_date_start ) * 1 ) as origin_span_years,
  ( title || ' [' || period || ']' || '' )     as title_with_period,
  case
    when lower(material) like '%stone%' then 'stone'
    when lower(material) like '%wood%'  then 'wood'
    when lower(material) like '%metal%' then 'metal'
    else 'other'
  end as material_group
from src
    );
  
  
