    era as era,
    credibility as credibility,
    source_ids as source_ids,
    notes as notes
  from "egypt_demo"."main_stg"."stg_flows"
),
jn as (
  select
    f.flow_id as flow_id,
    f.artifact_id as artifact_id,
    f.from_node_id as from_node_id,
