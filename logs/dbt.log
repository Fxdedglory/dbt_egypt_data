  ( name || '' )          as node_name,
  ( type || '' )          as node_type,
  ( country || '' )       as country_name,
  ( ( lat ) * 1 )            as latitude,
  ( ( lon ) * 1 )            as longitude,
  ( ( active_from ) * 1 )    as active_from_year,
  ( ( active_to ) * 1 )      as active_to_year,
  ( ( credibility ) * 1 )    as node_credibility,

  -- carry deriveds to keep lineage
  ( display_name || '' )      as display_name,
  ( ( active_span_years ) * 1 )  as active_span_years,
  ( geo_point || '' )         as geo_point,

  -- extra transform
  ( upper(type) || '' ) as node_type_upper
from base
    );
  
  
