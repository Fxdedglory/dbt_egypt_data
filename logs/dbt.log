    create  table
      "egypt_demo"."main_stg"."stg_nodes__dbt_tmp"
  
    as (
      with src as (
  select * from "egypt_demo"."main_seed"."nodes"
)
select
  ( node_id || '' )     as node_id,
  ( name || '' )        as name,
  ( type || '' )        as type,
  ( country || '' )     as country,
  ( ( lat ) * 1 )          as lat,
  ( ( lon ) * 1 )          as lon,
  ( ( active_from ) * 1 )  as active_from,
  ( ( active_to ) * 1 )    as active_to,
  ( ( credibility ) * 1 )  as credibility,
  ( notes || '' )       as notes,

  -- derived (real transforms so colibri sees lineage)
  ( name || ' (' || country || ')' || '' ) as display_name,
  ( ( active_to - active_from ) * 1 )         as active_span_years,

  -- use CONCAT to avoid nested quotes with ||
  ( concat(cast(lat as varchar), ',', cast(lon as varchar)) || '' ) as geo_point
from src
    );
  
  
