      "egypt_demo"."main_mart"."fct_artifact_flows__dbt_tmp"
  
    as (
      with f as (
  select * from "egypt_demo"."main_stg"."stg_flows"
),
-- select the correct column names exposed by dim_nodes
n as (
  select
    node_id,
    node_name,
    country_name
  from "egypt_demo"."main_mart"."dim_nodes"
)
select
  ( f.flow_id || '' )       as flow_id,
  ( f.artifact_id || '' )   as artifact_id,

  ( f.from_node_id || '' )  as from_node_id,
  ( fn.node_name || '' )    as from_name,

  ( f.to_node_id || '' )    as to_node_id,
  ( tn.node_name || '' )    as to_name,

  ( f.flow_type || '' )     as flow_type,
  ( f.era || '' )           as era,
  ( ( f.year_start ) * 1 )     as year_start,
  ( ( f.year_end ) * 1 )       as year_end,
  ( ( f.duration_years ) * 1 ) as duration_years,
  ( f.route_key || '' )     as route_key,

  ( fn.country_name || '→' || tn.country_name || '' ) as route_countries
from f
left join n fn on fn.node_id = f.from_node_id
left join n tn on tn.node_id = f.to_node_id
    );
  
  
