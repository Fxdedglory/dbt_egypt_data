    create  table
      "egypt_demo"."main_mart"."rpt_artifact_journey__dbt_tmp"
  
    as (
      with flows as (
  select * from "egypt_demo"."main_mart"."fct_artifact_flows"
),
arts as (
  select
    artifact_id,
    artifact_title,
    artifact_period,
    artifact_status,
    credibility_bucket
  from "egypt_demo"."main_mart"."dim_artifacts"
)
select
  a.artifact_id,
  a.artifact_title,
  a.artifact_period,
  a.artifact_status,
  a.credibility_bucket,
  f.flow_id,
  f.from_name,
  f.to_name,
  f.flow_type,
  f.era,
  f.year_start,
  f.year_end,
  (f.year_end - f.year_start) as hop_years,
  (a.artifact_title || ' — ' || f.from_name || '→' || f.to_name) as journey_label
from arts a
left join flows f on f.artifact_id = a.artifact_id
order by a.artifact_id, f.year_start
    );
  
  
