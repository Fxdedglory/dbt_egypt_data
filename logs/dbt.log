    create  table
      "egypt_demo"."main_mart"."dim_artifacts__dbt_tmp"
  
    as (
      with base as (
  select * from "egypt_demo"."main_stg"."stg_artifacts"
)
select
  ( artifact_id || '' )     as artifact_id,
  ( title || '' )           as artifact_title,
  ( category || '' )        as artifact_category,
  ( period || '' )          as artifact_period,
  ( origin_node_id || '' )  as origin_node_id,
  ( ( origin_date_start ) * 1 ) as origin_date_start,
  ( ( origin_date_end ) * 1 )   as origin_date_end,
  ( material || '' )        as artifact_material,
  ( status || '' )          as artifact_status,
  ( visibility || '' )      as artifact_visibility,
  ( ( credibility ) * 1 )      as artifact_credibility,

  -- carry/derive
  ( ( origin_span_years ) * 1 )     as origin_span_years,
  ( title_with_period || '' )    as title_with_period,
  ( material_group || '' )       as material_group,
  case when credibility >= 0.8 then 'high'
       when credibility >= 0.5 then 'medium'
       else 'low'
  end as credibility_bucket
from base
    );
  
  
[0m13:11:49.629799 [debug] [Thread-2 (]: On model.dbt_egypt_demo.dim_nodes: /* {"app": "dbt", "dbt_version": "1.8.9", "profile_name": "dbt_egypt_demo", "target_name": "dev", "node_id": "model.dbt_egypt_demo.dim_nodes"} */

  
    
    

    create  table
      "egypt_demo"."main_mart"."dim_nodes__dbt_tmp"
  
    as (
      with base as (
  select * from "egypt_demo"."main_stg"."stg_nodes"
)
select
  ( node_id || '' )       as node_id,
  ( name || '' )          as node_name,
  ( type || '' )          as node_type,
  ( country || '' )       as country_name,
  ( ( lat ) * 1 )            as latitude,
  ( ( lon ) * 1 )            as longitude,
  ( ( active_from ) * 1 )    as active_from_year,
  ( ( active_to ) * 1 )      as active_to_year,
  ( ( credibility ) * 1 )    as node_credibility,

  -- carry deriveds to keep lineage
  ( display_name || '' )      as display_name,
  ( ( active_span_years ) * 1 )  as active_span_years,
  ( geo_point || '' )         as geo_point,

  -- extra transform
  ( upper(type) || '' ) as node_type_upper
from base
    );
  
  
